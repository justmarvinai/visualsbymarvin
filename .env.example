# Copy to `.env` (gitignored) for local development.
# On Vercel, set these under Settings → Environment Variables instead.

# Your Duolingo profile name. Read only while the site builds — it is NOT
# prefixed with PUBLIC_, so Astro keeps it server-side and it never reaches
# the browser or the built HTML. Only the resulting streak number ships.
# Leave it unset to fall back to `streak` in src/data/sidequests.ts.
DUOLINGO_USERNAME=
