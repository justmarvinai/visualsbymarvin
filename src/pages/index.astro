---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Tools from '../components/Tools.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import Sidequests from '../components/Sidequests.astro';
import StickerBadge from '../components/StickerBadge.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
import heroPhoto from '../assets/image_pill_me.png';

const projects = (await getCollection('projects', ({ data }) => !data.draft && data.featured)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base>
  {/* ================= HERO ================= */}
  <section
    class="hero-sec relative wrap flex flex-col items-center pt-24 pb-16 text-center sm:pt-28 md:min-h-[38rem] md:pb-8"
  >
    {/* the pill stays the centrepiece — it just tilts to the cursor now,
        with the spinning sticker parked on its corner */}
    <div class="hero-pill-wrap relative" data-pill-tilt>
      <div class="hero-pill relative w-[min(340px,82vw)] overflow-hidden rounded-full sm:w-[420px]">
        <Image
          src={heroPhoto}
          alt={`Portrait of ${site.name}`}
          class="hero-pill-img block h-auto w-full"
          widths={[420, 680, 1024, 1364]}
          sizes="(min-width: 640px) 420px, 82vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <StickerBadge class="hero-sticker" />
    </div>

    <h1 class="display mt-8 leading-[1.06] font-bold sm:mt-10">
      {/* the size lives on .mask, not .mi — .mask's em-based descender
          padding has to resolve against the headline size, not 16px */}
      <span class="mask text-[clamp(3.3rem,11vw,6.5rem)] tracking-[-0.04em]">
        <span class="mi gate-mi block">
          I'm <span class="hl hl-lime">Marvin</span>
        </span>
      </span>
      <span class="mask text-[clamp(1.7rem,5.5vw,3.3rem)] font-semibold tracking-[-0.03em]">
        <span class="mi gate-mi block">
          Your <span class="hl hl-sky">Creative</span> Designer
        </span>
      </span>
    </h1>

    <p class="text-ink/80 mt-7 max-w-md text-[1.05rem] leading-relaxed text-balance sm:text-lg" data-enter>
      Junior Creative Designer from {site.location} focused on creating visuals that
      <span class="hl hl-thick hl-coral font-semibold">work</span>.
    </p>

    <Tools />
  </section>

  {/* ================= MARQUEE ================= */}
  <div class="marquee-bleed mt-2 sm:mt-4" data-reveal>
    <Marquee />
  </div>

  {/* ================= SELECTED WORK ================= */}
  <section id="work" class="wrap mt-20 scroll-mt-24 sm:mt-28">
    <div class="text-soft mx-auto flex max-w-5xl items-center justify-between text-sm" data-reveal>
      <p class="text-ink flex items-center gap-2 font-medium">
        <Logo class="text-lime-ink size-3.5" />
        Selected Work
      </p>
      <p class="tabular-nums">(<span data-count-to={projects.length} data-count-pad="2">{String(projects.length).padStart(2, '0')}</span>)</p>
    </div>

    <div class="mx-auto mt-8 grid max-w-5xl gap-x-10 gap-y-16 sm:mt-10 sm:gap-y-24 lg:grid-cols-2">
      {projects.map((project, index) => <ProjectCard {project} {index} />)}
    </div>
  </section>

  {/* ================= SIDEQUESTS ================= */}
  <Sidequests />
</Base>
