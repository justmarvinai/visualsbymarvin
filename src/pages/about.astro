---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CvButton from '../components/CvButton.astro';
import Timeline from '../components/Timeline.astro';
import { site } from '../data/site';
import { experience, education } from '../data/experience';
import { degree, focus, tools } from '../data/profile';
import photo from '../assets/image_pill_me.png';

/** ✏️ EDIT HERE: the quick facts next to the bio */
const facts = [
  ['Based in', site.location],
  ['University Degree', degree],
  ['Focus', 'Visual & Creative Design'],
  ['Status', site.availability],
];
---

<Base title="About me" description={`About ${site.name} — ${site.role} from ${site.location}.`}>
  <section class="wrap cq pt-5 sm:pt-8">
    <div class="label flex items-center justify-between gap-4" data-enter>
      <span>(About)</span>
      <span class="text-soft">{site.name}</span>
    </div>
    <hr class="hr mt-3" data-rule />

    <h1 class="display mt-8 text-[clamp(3.4rem,11.2cqi,10rem)] sm:mt-12">
      <span class="mask"><span class="mi gate-mi">Hey, I’m Marvin<span class="dot">.</span></span></span>
    </h1>

    {/* the full pill — the portrait keeps its own rounded shape */}
    <div class="mt-10 sm:mt-14" data-cover="pill">
      <Image
        src={photo}
        alt={`Portrait of ${site.name}`}
        class="block h-auto w-full"
        widths={[640, 960, 1364]}
        sizes="(min-width: 1440px) 1344px, 94vw"
        loading="eager"
      />
    </div>

    <div class="mt-16 grid gap-x-12 gap-y-14 sm:mt-24 lg:grid-cols-12">
      <aside class="lg:col-span-4" data-reveal>
        <dl class="text-[0.95rem]">
          {
            facts.map(([k, v]) => (
              <div class="border-ink/15 flex items-baseline justify-between gap-4 border-t py-3.5">
                <dt class="text-soft">{k}</dt>
                <dd class="text-right font-semibold">{v}</dd>
              </div>
            ))
          }
        </dl>
        <CvButton class="mt-6" />
      </aside>

      <div class="lg:col-span-8">
        <p
          class="text-[clamp(1.5rem,3.2cqi,2.4rem)] leading-[1.15] font-bold tracking-[-0.025em] [font-stretch:112%]"
          data-reveal
        >
          I design digital graphics for Meta, Google, <span class="whitespace-nowrap">E-Mail-Campaigns</span> & Your
          in-house website, which simply work<span class="dot">.</span>
        </p>
        <div class="text-ink/80 mt-8 max-w-2xl space-y-5 text-[1.05rem] leading-relaxed" data-reveal>
          <p>
            I’m a junior marketing designer from {site.location}. I graduated with a B.A. in Media Design
            in March 2026 and have been working for a business gifts company since then. I'm also a huge
            nerd for Gaming & Anime/Manga. If you don't see me building my next design I probably replay
            my favorite game right now.
          </p>
          <p>
            I care about the brands and people I work with, and I adapt my designs to fit their visual identity.
          </p>
          <p>
            Right now, I’m looking for a team where I can learn quickly, take on responsibility early,
            and continue improving my digital design skills. If that sounds like you, we might be a match.
          </p>
        </div>

        <dl class="border-ink/15 mt-12 grid gap-x-6 gap-y-8 border-t pt-6 sm:grid-cols-2" data-reveal>
          <div>
            <dt class="label">Focus</dt>
            <dd class="mt-3 text-[1.05rem] leading-relaxed font-semibold">{focus.join(' · ')}</dd>
          </div>
          <div>
            <dt class="label">Tools</dt>
            <dd class="mt-3 text-[1.05rem] leading-relaxed font-semibold">{tools.join(' · ')}</dd>
          </div>
        </dl>
      </div>
    </div>

    {/* experience + education */}
    <div class="mt-28 sm:mt-40">
      <h2 class="display title-xl" data-mask>
        <span class="mask"><span class="mi">Background<span class="dot">.</span></span></span>
      </h2>
      <div class="mt-10 space-y-14 sm:mt-14">
        <Timeline title="Experience" items={experience} />
        <Timeline title="Education" items={education} />
      </div>
    </div>
  </section>
</Base>
