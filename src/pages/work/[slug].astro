---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { dash } from '../../utils/typo';

export async function getStaticPaths() {
  const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: all[(i + 1) % all.length], index: i, total: all.length },
  }));
}

const { project, next, index, total } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const pad = (n: number) => String(n).padStart(2, '0');

const meta = [
  ['Category', d.categories.join(' / ')],
  ['Year', d.year],
  ['Role', d.role],
  ['Tools', d.tools.join(', ')],
].filter(([, v]) => v);
---

<Base title={d.title} description={d.description}>
  {/* data-zoom → app.js makes the cover + every body image open full size */}
  <article class="pt-5 sm:pt-8" data-zoom>
    <header class="wrap cq">
      <div class="label flex items-center justify-between gap-4" data-enter>
        <a href="/#work" class="u-link inline-flex items-center gap-1.5">
          <Icon name="arrow-left" class="size-3.5" />
          All work
        </a>
        <span class="text-soft num">Project {pad(index + 1)} / {pad(total)}</span>
      </div>
      <hr class="hr mt-3" data-rule />

      <h1 class="display mt-8 text-[clamp(2.9rem,9.4cqi,8.5rem)] text-balance sm:mt-12">
        <span class="mask"><span class="mi gate-mi">{dash(d.title)}<span class="dot">.</span></span></span>
      </h1>

      <div class="mt-10 grid gap-x-10 gap-y-10 sm:mt-14 lg:grid-cols-12">
        <p class="max-w-xl text-[1.2rem] leading-snug font-semibold tracking-[-0.01em] sm:text-[1.4rem] lg:col-span-5" data-enter>
          {d.description}
        </p>
        <dl class="spec grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4 lg:col-span-6 lg:col-start-7" data-enter>
          {
            meta.map(([k, v]) => (
              <div class="border-ink border-t pt-3">
                <dt class="label">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
          {
            d.externalUrl && (
              <div class="border-ink border-t pt-3">
                <dt class="label">Live</dt>
                <dd>
                  <a class="u-link inline-flex items-center gap-1" href={d.externalUrl} target="_blank" rel="noopener noreferrer">
                    Open link
                    <Icon name="arrow-up-right" class="size-3.5" />
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      {/* cover, inside printer's crop marks */}
      <div class="crop mt-12 sm:mt-16" data-crop-cover>
        <div class="bg-sunk overflow-hidden" data-cover>
          <Image
            src={d.cover}
            alt={d.coverAlt ?? `Cover of ${d.title}`}
            class="block h-auto w-full"
            widths={[760, 1100, 1600, 2000]}
            sizes="(min-width: 1440px) 1344px, 94vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    {/* markdown body — images do the talking */}
    <div class="wrap">
      <div class="article mt-16 sm:mt-24">
        <Content />
      </div>
    </div>

    {/* next project */}
    <a href={`/work/${next.id}/`} class="next border-ink/15 mt-28 border-y sm:mt-40">
      <div class="wrap cq flex items-end justify-between gap-6 py-12 sm:py-16">
        <div class="min-w-0">
          <p class="label next-soft text-soft">Next project</p>
          <p class="display mt-4 text-[clamp(2.2rem,7.6cqi,6.75rem)] text-balance sm:mt-6">{dash(next.data.title)}</p>
        </div>
        <Icon name="arrow-right" class="ico size-10 shrink-0 sm:size-16" />
      </div>
    </a>
  </article>
</Base>
