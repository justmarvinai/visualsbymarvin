---
import CvButton from './CvButton.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

/**
 * FOOTER — the one full colour field on the site.
 * ✏️ EDIT HERE: the closing line. No "let's talk" on purpose: the
 *    people reading this already have your application in hand.
 */
const year = new Date().getFullYear();
const socials = site.socials.filter((s) => s.url);
---

<footer class="foot mt-32 sm:mt-48">
  <div class="wrap cq pt-14 sm:pt-20">
    <div class="label flex items-center justify-between gap-4" data-reveal>
      <span>(End)</span>
      <span>{site.name}</span>
    </div>

    <h2 class="display title-xl mt-6 sm:mt-10" data-mask>
      <span class="mask"><span class="mi">Thanks for</span></span>
      <span class="mask"><span class="mi">your time.</span></span>
    </h2>

    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5 sm:mt-14" data-reveal>
      <CvButton variant="ink" />
      {
        socials.length > 0 && (
          <ul class="flex flex-wrap gap-x-6 gap-y-2 text-[0.95rem] font-semibold">
            {socials.map((s) => (
              <li>
                <a class="u-link inline-flex items-center gap-1" href={s.url} target="_blank" rel="noopener noreferrer">
                  {s.label}
                  <Icon name="arrow-up-right" class="size-3.5" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <hr class="hr mt-16 sm:mt-24" />

    <div class="flex flex-col gap-3 py-6 text-sm font-medium sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}</p>
      <nav aria-label="Legal and site">
        <ul class="flex flex-wrap gap-x-5 gap-y-1">
          <li><a href="/imprint/" class="u-link">Impressum</a></li>
          <li><a href="/privacy/" class="u-link">Datenschutz</a></li>
          <li><a href="/about/" class="u-link">About me</a></li>
          <li><a href="#top" class="u-link" data-scroll-top>Back to top</a></li>
        </ul>
      </nav>
      <p class="num">{site.location} · <span data-time>--:--</span></p>
    </div>
  </div>
</footer>
