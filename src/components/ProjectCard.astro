---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const d = project.data;

// each card wears the next accent in the family, so the grid reads
// colourful without anyone having to pick a colour per project
const accents = ['lime', 'violet', 'coral', 'sky'] as const;
const accent = accents[index % accents.length];
---

<article class:list={['group relative pcard', `pcard-${accent}`]} data-card>
  {/* stretched link — the whole card is clickable */}
  <a
    href={`/work/${project.id}/`}
    class="absolute inset-0 z-10 rounded-3xl"
    aria-label={`View project: ${d.title}`}></a>

  <div class="pcard-frame">
    <div class="card-img aspect-[16/9]" data-card-img>
      <Image
        src={d.cover}
        alt={d.coverAlt ?? `Cover of ${d.title}`}
        widths={[480, 760, 1100, 1600]}
        sizes="(min-width: 1152px) 1088px, 92vw"
        loading={index === 0 ? 'eager' : 'lazy'}
      />
    </div>
    <span class="pcard-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>

  {/* full-width cards leave far too much empty space for a single text
      column, so the title and the blurb sit side by side from md up */}
  <div class="mt-6 grid gap-x-12 gap-y-4 sm:mt-8 md:grid-cols-[1fr_1fr] md:items-start">
    <div>
      <h3 class="display text-[1.6rem] leading-tight font-bold tracking-tight sm:text-[2.1rem]">
        {d.title}
      </h3>
      <p class="pcard-cats">
        {d.categories.map((c) => <span>{c}</span>)}
      </p>
    </div>
    <div>
      <p class="text-ink/75 text-[15px] leading-relaxed sm:text-base">{d.description}</p>
      <span class="btn pcard-btn mt-5" aria-hidden="true">
        View Project
        <svg class="arr size-3.5" viewBox="0 0 16 16" fill="none">
          <path
            d="M4 12L12 4M12 4H5.5M12 4v6.5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</article>
