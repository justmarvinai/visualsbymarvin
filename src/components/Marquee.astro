---
import Logo from './Logo.astro';

/**
 * MARQUEE BAND
 * ------------------------------------------------------------
 * Full-bleed scrolling strip, tilted a couple of degrees so it cuts
 * across the page. Purely decorative → aria-hidden, and it holds
 * still for anyone who asked for reduced motion.
 *
 * ✏️ EDIT HERE: the words in `items`, or pass your own:
 *      <Marquee items={['One', 'Two']} tilt="1.5deg" />
 */
interface Props {
  items?: string[];
  /** Rotation of the whole band. Use a negative value to tilt the other way. */
  tilt?: string;
  /** Seconds for one full loop — bigger is slower. */
  speed?: number;
  class?: string;
}

const {
  items = ['Ad Design', 'Social Media', 'Game Design', 'AI Workflows', 'Brand Visuals'],
  tilt = '-2deg',
  speed = 38,
  class: className = '',
} = Astro.props;

/**
 * The track scrolls left by exactly one run, so the remaining (REPEATS - 1)
 * runs have to be wider than the band or the tail end runs dry — which is
 * what happened with only two copies: one run of these five words measures
 * ~1240px, while the band is 108vw (over 3700px on a 3440px display).
 *
 * Six copies cover a band of ~6200px (a 5K display) with this word list, and
 * a shorter list gets proportionally more copies.
 */
const REPEATS = Math.max(6, Math.ceil(30 / Math.max(items.length, 1)));
---

<div
  class:list={['marquee', className]}
  style={`--tilt:${tilt};--marquee-dur:${speed}s`}
  aria-hidden="true"
>
  <div class="marquee-track" style={`--marquee-shift:-${(100 / REPEATS).toFixed(4)}%`}>
    {
      /* one run scrolls past per loop; the rest keep the band filled */
      Array.from({ length: REPEATS }).map(() => (
        <div class="marquee-run">
          {items.map((item) => (
            <>
              <span>{item}</span>
              <Logo class="marquee-star size-[0.62em] shrink-0" />
            </>
          ))}
        </div>
      ))
    }
  </div>
</div>
