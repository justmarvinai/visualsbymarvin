---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * DUOLINGO STREAK WIDGET
 * ------------------------------------------------------------
 * Styled after Duolingo's own UI — white card, 2px grey outline,
 * their orange flame and the chunky green button with the solid
 * bottom edge. It deliberately keeps Duolingo's light palette in
 * BOTH site themes, so it reads as an embedded app widget rather
 * than a card that happens to be green.
 *
 * ✏️ DUO MASCOT: drop an image at `src/assets/duo.png` (or .webp
 *    /.svg/.jpg) and he appears peeking over the card. No other
 *    change needed — while the file is missing the widget simply
 *    renders without him.
 */
interface Props {
  streak: number;
  language: string;
  href: string;
  /** true when the number came from the live profile rather than the data file */
  live?: boolean;
}
const { streak, language, href, live = false } = Astro.props;

// import.meta.glob returns {} when nothing matches, so a missing mascot
// can never break the build the way a bare import would
const duoFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/duo.{png,webp,svg,jpg,jpeg}',
  { eager: true }
);
const duo = Object.values(duoFiles)[0]?.default;
---

<a class="duo" href={href} target="_blank" rel="noopener noreferrer" data-reveal>
  <div class="duo-top">
    <span class="duo-lang">
      {/* Japan — drawn rather than an emoji flag, which many desktop
          browsers refuse to render */}
      <svg class="duo-flag" viewBox="0 0 30 21" aria-hidden="true">
        <rect width="30" height="21" rx="4" fill="#fff"></rect>
        <circle cx="15" cy="10.5" r="6.2" fill="#BC002D"></circle>
        <rect x="0.75" y="0.75" width="28.5" height="19.5" rx="3.25" fill="none" stroke="#E5E5E5" stroke-width="1.5"></rect>
      </svg>
      {language}
    </span>
    {live && <span class="duo-badge">Live</span>}
  </div>

  <div class="duo-body">
    <svg class="duo-flame" viewBox="0 0 64 80" aria-hidden="true">
      {/* outer flame */}
      <path
        fill="#FF9600"
        d="M35.6 1.4c-1.2-1.5-3.6-1-4.1.9-1.5 5.8-4.7 10-8.3 13.8-4.6 4.8-11.6 11.7-11.6 22.6C11.6 57.4 20.7 68 32 68s20.4-10.6 20.4-29.3c0-7.6-3.3-13.6-6.6-18-.9 3.4-2.6 5.9-5 7.2 1.5-9.4-1.5-19.4-5.2-26.5Z"
      ></path>
      {/* inner flame */}
      <path
        fill="#FFC800"
        d="M33.4 33.6c-.8-1-2.5-.7-2.8.6-.8 3.2-2.6 5.5-4.6 7.6-2.5 2.7-6.4 6.5-6.4 12.5C19.6 64.2 25.2 70 32 70s12.4-5.8 12.4-15.7c0-4.2-1.8-7.5-3.6-10-.5 1.9-1.4 3.3-2.8 4 .8-5.2-1.5-10.8-4.6-14.7Z"
      ></path>
    </svg>

    <p class="duo-num" data-count-to={streak}>{streak}</p>
    <p class="duo-unit">day streak</p>
  </div>

  <span class="duo-btn">Keep it up</span>

  {
    duo && (
      <Image class="duo-mascot" src={duo} alt="" widths={[180, 300]} sizes="150px" loading="lazy" aria-hidden="true" />
    )
  }
</a>
