---
import DuoStreak from './DuoStreak.astro';
import Icon from './Icon.astro';
import { duolingo, quests, fetchDuolingoStreak } from '../data/sidequests';

/**
 * SIDEQUESTS — the things outside the day job.
 *
 * The streak is resolved at build time: live from the profile when a
 * username is set, otherwise the number in src/data/sidequests.ts.
 * When it ends up at 0 the card is left out entirely, so a placeholder
 * streak never ships.
 */
const live = await fetchDuolingoStreak(duolingo.username);
const streak = live ?? duolingo.streak;
const showStreak = streak > 0;
---

<section id="sidequests" class="wrap cq mt-32 scroll-mt-20 sm:mt-48">
  <div class="label flex items-center justify-between gap-4" data-reveal>
    <span>(03)</span>
    <span class="text-soft">Outside the day job</span>
  </div>

  <h2 class="display title-xl mt-4 sm:mt-6" data-mask>
    <span class="mask"><span class="mi">Sidequests<span class="dot">.</span></span></span>
  </h2>

  <div class="mt-12 grid gap-5 sm:mt-16 lg:grid-cols-12">
    {
      showStreak && (
        <div class="lg:col-span-4">
          <DuoStreak streak={streak} language={duolingo.language} href={duolingo.profileUrl} live={live !== null} />
        </div>
      )
    }

    {
      quests.map((q) => (
        <article
          class:list={[
            'quest group',
            // alone in the row it splits into two columns, so the card
            // never turns into one wide, half-empty strip
            showStreak ? 'lg:col-span-8' : 'md:grid md:grid-cols-2 md:gap-x-12 lg:col-span-12',
          ]}
          data-reveal
        >
          {q.link && (
            <a
              href={q.link.href}
              target={q.link.external ? '_blank' : undefined}
              rel={q.link.external ? 'noopener noreferrer' : undefined}
              class="absolute inset-0 z-10"
              aria-label={`${q.title} — ${q.link.label}`}
            />
          )}

          <div>
            <p class="label text-soft">{q.kicker}</p>
            <h3 class="display mt-5 text-[clamp(2rem,4.6cqi,3.6rem)] leading-[0.95] text-balance">{q.title}</h3>
          </div>

          <div class="flex grow flex-col">
            <p class:list={['text-ink/75 max-w-xl leading-relaxed', showStreak ? 'mt-5' : 'mt-5 md:mt-0']}>{q.blurb}</p>

            {q.tags && (
              <ul class="quest-tags label mt-6">
                {q.tags.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            )}

            {q.link && (
              <p class="go mt-auto pt-10 text-[0.95rem]">
                {q.link.label}
                <Icon name={q.link.external ? 'arrow-up-right' : 'arrow-right'} class="ico" />
              </p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
