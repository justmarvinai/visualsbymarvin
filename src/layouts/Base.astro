---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
// the Latin cut of Archivo — preloaded so the headline never paints in a
// fallback font first (same file the stylesheet uses, so no double fetch)
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-standard-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const ogImage = new URL('/og.jpg', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* Runs before first paint: marks JS as available (enables the animation
        initial states) and applies the saved colour theme, so there is never
        a flash of the wrong theme. */}
    <script is:inline>
      (() => {
        const el = document.documentElement;
        el.classList.add('js');
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        el.dataset.theme = theme;
      })();
    </script>

    <ClientRouter />
  </head>
  <body id="top" class="min-h-screen">
    <a class="skip" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
